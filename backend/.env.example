PORT=5000
NODE_ENV=development

# Local Docker/Sequelize connection. Docker Compose overrides DB_HOST to postgres.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=table_management
DB_USER=postgres
DB_PASSWORD=your_password
DB_SYNC_ALTER=false

# Leave DATABASE_URL empty for local Docker. If NODE_ENV=production and DATABASE_URL is set,
# backend/src/config/database.js will use the remote URL with SSL instead of DB_*.
DATABASE_URL=

JWT_SECRET=dev_secret_change_me
JWT_EXPIRES_IN=24h
QR_TOKEN_EXPIRES=365d
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456
ADMIN_FULL_NAME=Smart Restaurant Admin

# Current email config in backend/src/config/email.js uses SendGrid variables.
SENDGRID_API_KEY=
SENDGRID_FROM=

# These Gmail SMTP variables are not read by the current backend email config.
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_IPN_URL=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api
